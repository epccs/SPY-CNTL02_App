{
    "configurations": [
        {
            "name": "STM32C092xx",
            "includePath": [
                "${workspaceFolder}/**/Core/Inc",
                "${workspaceFolder}/STM32C092FCP6/Drivers/STM32C0xx_HAL_Driver/Inc",
                "${workspaceFolder}/STM32C092FCP6/Drivers/STM32C0xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/STM32C092FCP6/Drivers/CMSIS/Device/ST/STM32C0xx/Include",
                "${workspaceFolder}/STM32C092FCP6/Drivers/CMSIS/Include"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32C092xx"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "compilerArgs": [
                "-mcpu=cortex-m0plus",
                "-mthumb"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4
}
